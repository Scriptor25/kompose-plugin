<idea-plugin>
    <id>dev.scriptor.kompose-plugin</id>

    <name>Kompose</name>

    <vendor url="https://kompose-plugin.scriptor.dev">Scriptor</vendor>

    <description>
        <![CDATA[
            <p>IntelliJ support plugin for Kompose, a lightweight Kotlin build tool.</p>
        ]]>
    </description>

    <depends>com.intellij.modules.platform</depends>
    <depends>com.intellij.modules.java</depends>

    <depends>org.jetbrains.kotlin</depends>

    <extensions defaultExtensionNs="com.intellij">
        <projectImportBuilder implementation="dev.scriptor.kompose.KomposeProjectImportBuilder"/>
        <projectImportProvider implementation="dev.scriptor.kompose.KomposeProjectImportProvider"/>

        <projectOpenProcessor implementation="dev.scriptor.kompose.KomposeProjectOpenProcessor" order="first"/>

        <externalSystemManager implementation="dev.scriptor.kompose.KomposeManager"/>

        <externalSystemUnlinkedProjectAware implementation="dev.scriptor.kompose.KomposeUnlinkedProjectAware"/>

        <externalProjectDataService implementation="dev.scriptor.kompose.KomposeProjectDataService"/>
        <externalProjectDataService implementation="dev.scriptor.kompose.KomposeModuleDataService"/>

        <configurationType implementation="dev.scriptor.kompose.KomposeRunConfigurationType"/>

        <externalSystem.facetConfigurationImporter
                implementation="dev.scriptor.kompose.KomposeFacetConfigurationImporter"/>

        <newProjectWizard.generator implementation="dev.scriptor.kompose.KomposeNewProjectWizard"/>
    </extensions>

    <actions>
        <group id="v6gxpx.Kompose" text="Kompose" popup="true">
            <action id="v6gxpx.Kompose.Clean"
                    class="dev.scriptor.kompose.action.KomposeCleanAction"
                    text="Clean"/>
            <action id="v6gxpx.Kompose.Compile"
                    class="dev.scriptor.kompose.action.KomposeCompileAction"
                    text="Compile"/>
            <action id="v6gxpx.Kompose.Launch"
                    class="dev.scriptor.kompose.action.KomposeLaunchAction"
                    text="Launch"/>

            <group id="v6gxpx.Kompose.Package" text="Package" popup="true">
                <action id="v6gxpx.Kompose.Package.SlimJar"
                        class="dev.scriptor.kompose.action.KomposePackageAction"
                        text="Slim Jar"/>
                <action id="v6gxpx.Kompose.Package.FatJar"
                        class="dev.scriptor.kompose.action.KomposePackageFatJarAction"
                        text="Fat Jar"/>
            </group>

            <add-to-group group-id="BuildMenu"
                          anchor="last"/>
        </group>
    </actions>

</idea-plugin>
