<idea-plugin>
    <id>dev.scriptor.kompose-plugin</id>

    <name>Kompose</name>

    <vendor url="https://kompose-plugin.scriptor.dev">Scriptor</vendor>

    <description>
        <![CDATA[
            <p>Intellij support plugin for the lightweight Kompose Kotlin build tool.</p>
        ]]>
    </description>

    <depends>com.intellij.modules.platform</depends>

    <extensions defaultExtensionNs="com.intellij">
        <projectService serviceImplementation="dev.scriptor.kompose.KomposeSettings"/>

        <externalSystemManager implementation="dev.scriptor.kompose.KomposeSystemManager"/>
        <externalSystemUnlinkedProjectAware implementation="dev.scriptor.kompose.KomposeUnlinkedProjectAware"/>

        <configurationType implementation="dev.scriptor.kompose.KomposeRunConfigurationType"/>
    </extensions>

    <actions>
        <group id="v6gxpx.Kompose" text="Kompose" popup="true">
            <action id="v6gxpx.Kompose.Clean"
                    class="dev.scriptor.kompose.action.KomposeCleanAction"
                    text="Clean"/>
            <action id="v6gxpx.Kompose.Compile"
                    class="dev.scriptor.kompose.action.KomposeCompileAction"
                    text="Compile"/>
            <action id="v6gxpx.Kompose.Launch"
                    class="dev.scriptor.kompose.action.KomposeLaunchAction"
                    text="Launch"/>

            <group id="v6gxpx.Kompose.Package" text="Package" popup="true">
                <action id="v6gxpx.Kompose.Package.SlimJar"
                        class="dev.scriptor.kompose.action.KomposePackageAction"
                        text="Slim Jar"/>
                <action id="v6gxpx.Kompose.Package.FatJar"
                        class="dev.scriptor.kompose.action.KomposePackageFatJarAction"
                        text="Fat Jar"/>
            </group>

            <action id="v6pxpx.Kompose.Build"
                    class="dev.scriptor.kompose.action.KomposeCompileAction"
                    text="Build"/>

            <add-to-group group-id="BuildMenu"
                          anchor="last"/>
        </group>
    </actions>

</idea-plugin>
